{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pigsfield",
  "compatibility_date": "2026-06-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": ["node_modules", ".git", ".wrangler"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
