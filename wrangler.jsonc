{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pigsfield",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-07-09",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "2026071501",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "AI_IP_RATE_LIMITER",
      "namespace_id": "2026071502",
      "simple": {
        "limit": 24,
        "period": 60
      }
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
